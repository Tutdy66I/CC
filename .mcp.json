{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "C:\\Users\\Tu't'd'y\\AppData\\Local\\codegraph\\current\\node.exe",
      "args": ["--liftoff-only", "C:\\Users\\Tu't'd'y\\AppData\\Local\\codegraph\\current\\lib\\dist\\bin\\codegraph.js", "serve", "--mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--executable-path", "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:\\Users\\Tu't'd'y\\Documents"]
    },
    "sqlite": {
      "command": "npx",
      "args": ["-y", "mcp-sqlite-server"]
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "mcp-server-fetch-typescript"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    }
  }
