{
  "name": "react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:deepseek": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-deepseek.ps1",
    "start:deepseek": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-deepseek.ps1 -Production",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build && node scripts/generate-rss.js",
    "start": "node .server-build/server/productionServer.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "benchmark:ber": "tsc -p tsconfig.test.json && node scripts/benchmark-ber.mjs",
    "test:e2e": "playwright test",
    "test:pages": "playwright test --config=playwright.pages.config.ts",
    "test:cloud": "playwright test --config=playwright.cloud.config.ts",
    "test:e2e:server": "node scripts/e2e-server.mjs",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js && node --test tests/backup.test.mjs",
    "test:channel-tools": "node --test tests/channel-tools.test.mjs",
    "test:ofdm-reference": "tsc -p tsconfig.test.json && node --test tests/ofdm-reference.test.mjs",
    "test:ofdm-comb-reference": "tsc -p tsconfig.test.json && node --test tests/ofdm-comb-reference.test.mjs",
    "accept:ofdm-native": "tsc -p tsconfig.test.json && node scripts/accept-ofdm-native.mjs",
    "plan:ofdm-study": "tsc -p tsconfig.test.json && node scripts/plan-ofdm-study.mjs",
    "study:ofdm": "tsc -p tsconfig.test.json && node scripts/study-ofdm-research.mjs",
    "inspect:ofdm": "tsc -p tsconfig.test.json && node scripts/inspect-ofdm-research.mjs",
    "benchmark:ofdm": "tsc -p tsconfig.test.json && node scripts/benchmark-ofdm-research.mjs",
    "study:channel": "node scripts/study-channel-research.mjs",
    "inspect:channel": "node scripts/inspect-channel-research.mjs",
    "benchmark:channel": "node scripts/benchmark-channel-research.mjs",
    "restore:v11": "node scripts/restore-v11-reference.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "6.2.6",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
