{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": ".test-build"
  },
  "include": [
    "tests/**/*.test.ts",
    "src/lib/ofdmSync/**/*.ts",
    "src/workers/ofdmSync.worker.ts",
    "src/lib/routes.ts",
    "src/lib/rss.ts",
    "server/rssProxy.ts",
    "server/rssProxyHandler.ts",
    "server/productionServer.ts"
  ]
}
