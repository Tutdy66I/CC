{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": ".test-build"
  },
  "include": ["tests/**/*.test.ts", "src/lib/routes.ts", "server/rssProxy.ts"]
}
